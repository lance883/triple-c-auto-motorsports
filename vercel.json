{
  "version": 2,
  "functions": {
    "api/credit-application.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/{pdfkit/js/data/**,@fontsource/noto-sans/files/noto-sans-latin-400-normal.woff}"
    },
    "api/credit-delivery-test.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/{pdfkit/js/data/**,@fontsource/noto-sans/files/noto-sans-latin-400-normal.woff}"
    }
  },
  "headers": [
    {
      "source": "/credit-application.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "outputDirectory": "dist"
}
